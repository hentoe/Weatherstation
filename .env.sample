# General
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=app.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=backend.example.com

# Database
DB_NAME=dbname
DB_USER=rootuser
DB_PASS=changeme
DB_HOST=db

# SSL
ACME_DEFAULT_EMAIL=email@example.com
DOMAIN=backend.example.com
SSL=false

# Frontend CORS and CSRF origins (comma-separated, including scheme)
VUE_FRONTEND_ORIGINS=https://frontend.example.com

# EMAIL
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=info@example.com
EMAIL_HOST_PASSWORD=supersecurepassword
DEFAULT_FROM_EMAIL=info@example.com
SERVER_EMAIL=info@example.com

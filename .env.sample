# General
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=app.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=subdomain.example.de

# Database
DB_NAME=dbname
DB_USER=rootuser
DB_PASS=changeme
DB_HOST=db
# Use a new volume name when migrating to a new PostgreSQL major version.
POSTGRES_DATA_VOLUME=wetterstation-postgres-data-pg18

# SSL
ACME_DEFAULT_EMAIL=email@example.com
DOMAIN=subdomain.example.de
# TLS is terminated by the external reverse proxy, not this container.
SSL=false
PUBLIC_HTTPS=true

# Frontend CORS and CSRF origins (comma-separated, including scheme)
VUE_FRONTEND_ORIGINS=https://example.de,https://www.example.de

# EMAIL
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=info@example.com
EMAIL_HOST_PASSWORD=supersecurepassword
DEFAULT_FROM_EMAIL=info@example.com
SERVER_EMAIL=info@example.com
